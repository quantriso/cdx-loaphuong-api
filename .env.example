# Service Configuration
PORT=3000
NODE_ENV=development
SERVICE_NAME=cdx-loaphuong
SERVICE_VERSION=1.0.0

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cdx_loaphuong
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cdx_loaphuong

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_EXCHANGE=loaphuang.events
RABBITMQ_MAX_RETRIES=3
RABBITMQ_RETRY_DELAY=1000

# MinIO Configuration
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGION=us-east-1
MINIO_UPLOAD_URL_EXPIRY=900
MINIO_DOWNLOAD_URL_EXPIRY=3600
MINIO_BUCKET_CONTENT_FILES=content-files
MINIO_BUCKET_USER_AVATARS=user-avatars
MINIO_BUCKET_THUMBNAILS=thumbnails

# Observability
LOG_LEVEL=debug
JAEGER_ENDPOINT=http://localhost:14268/api/traces
PROMETHEUS_PORT=9464

# Security
JWT_SECRET=super-secret-key-change-me-in-production
RATE_LIMIT_REDIS_URL=redis://localhost:6379
